# ==========================================
# PORTFOLIO BACKEND CONFIGURATION
# ==========================================
PORT=5000

# ==========================================
# EMAIL DELIVERY CONFIGURATION (Nodemailer)
# ==========================================
# Your Gmail address used to send the notifications
EMAIL_USER=divy9anshu@gmail.com

# 16-character Google App Password (NOT your regular Gmail password)
# How to get your Google App Password:
# 1. Visit: https://myaccount.google.com/security
# 2. Enable "2-Step Verification" (if not already enabled)
# 3. Search for "App Passwords" in the Google Account search bar (or visit https://myaccount.google.com/apppasswords)
# 4. Enter app name "Portfolio Contact" and click Create
# 5. Copy the 16-character generated password (e.g. abcd efgh ijkl mnop) and paste it below:
EMAIL_PASS=

# The inbox where contact form inquiries should be delivered (defaults to divy9anshu@gmail.com)
CONTACT_RECEIVER_EMAIL=divy9anshu@gmail.com

# Automatically send a polite acknowledgment email back to the visitor
SEND_AUTO_REPLY=true

# ==========================================
# TESTIMONIAL / REVIEW AUTHENTICATION
# ==========================================
REVIEW_PASSKEY=divy2026

# (Optional) Google OAuth Client ID for Google Identity Services token verification
# Create free at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=


# ==========================================
# OPTIONAL: CUSTOM SMTP CONFIGURATION
# (Only needed if NOT using Gmail)
# ==========================================
